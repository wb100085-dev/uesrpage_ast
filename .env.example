NEXT_PUBLIC_API_URL=http://localhost:8000

# Hackle App/Browser SDK key (never use the Server SDK key).
# Use the development key in .env.development.local; production key in
# .env.production.local or the hosting provider's production environment.
# Leave empty to disable Hackle without affecting GA4 or the product.
NEXT_PUBLIC_HACKLE_SDK_KEY=
